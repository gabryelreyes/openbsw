load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "bsp_mcu",
    srcs = ["src/reset/softwareSystemReset.cpp"],
    hdrs = glob(["include/**/*.h"]),
    # Selects the device in the NXP peripheral access layer headers (S32K3_DEVICE_UPPER on the CMake side).
    defines = ["S32K344"],
    strip_include_prefix = "include",
    target_compatible_with = ["//bazel/platform/constraints/soc:s32k344"],
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/cmsis",
    ],
)
