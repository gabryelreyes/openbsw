load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "bsp_configuration_headers",
    hdrs = glob(["include/bsp/**/*.h"]),
    strip_include_prefix = "include",
    target_compatible_with = ["//bazel/platform/constraints/soc:s32k344"],
    visibility = ["//visibility:public"],
    deps = [
        "//libs/bsp/bspInterrupts:bsp_interrupts",
        "//platforms/s32k3xx/bsp/bspAdc:bsp_adc_headers",
        "//platforms/s32k3xx/bsp/bspMcu:bsp_mcu",
    ],
)

cc_library(
    name = "bsp_configuration",
    srcs = [
        "src/bsp/SystemTimer/SystemTimer.cpp",
        "src/bsp/adc/AnalogInput.cpp",
        "src/bsp/stdIo/stdIo.cpp",
        "src/bsp/uart/UartConfig.cpp",
    ],
    target_compatible_with = ["//bazel/platform/constraints/soc:s32k344"],
    visibility = ["//visibility:public"],
    deps = [
        ":bsp_configuration_headers",
        "//libs/3rdparty/etl",
        "//libs/bsp/bspInterrupts:bsp_interrupts",
        "//libs/bsp/bspOutputPwm:bsp_output_pwm",
        "//libs/bsw/bsp",
        "//platforms/s32k3xx/bsp/bspAdc:bsp_adc",
        "//platforms/s32k3xx/bsp/bspIo:bsp_io",
        "//platforms/s32k3xx/bsp/bspMcu:bsp_mcu",
        "//platforms/s32k3xx/bsp/bspUart:bsp_uart",
    ],
    # Board-config symbols are consumed by later archives. Without force-link single-pass linking drops them.
    alwayslink = True,
)
