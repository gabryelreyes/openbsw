load("@rules_cc//cc:cc_library.bzl", "cc_library")

genrule(
    name = "generate_linkerscript",
    srcs = ["linkerscript/application.dld.in"],
    outs = ["application.dld"],
    cmd = "$(CC) $(CC_FLAGS) -E -P -x c -I $$(dirname $(location linkerscript/application.dld.in)) $(location linkerscript/application.dld.in) -o $@",
    target_compatible_with = ["//bazel/platform/constraints/soc:s32k344"],
    toolchains = [
        "@bazel_tools//tools/cpp:current_cc_toolchain",
        "@bazel_tools//tools/cpp:cc_flags",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "start_up_asm",
    srcs = [
        "src/bsp/bootHeader.S",
        "src/bsp/startUp.S",
    ],
    target_compatible_with = [
        "//bazel/platform/constraints/soc:s32k344",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:public"],
    # Force-link needed because boot header and vectors are referenced by address, not symbol.
    alwayslink = True,
)

cc_library(
    name = "start_up",
    srcs = ["src/os/isr/isr_can.cpp"],
    implementation_deps = [":start_up_asm"],
    target_compatible_with = ["//bazel/platform/constraints/soc:s32k344"],
    visibility = ["//visibility:public"],
    # ISR implementations are only referenced by address from the vector table. Without force-link single-pass linking drops them.
    alwayslink = True,
)

cc_library(
    name = "freertos_os_hooks",
    srcs = ["src/osHooks/freertos/osHooks.cpp"],
    implementation_deps = [
        "//libs/3rdparty/etl",
        "//libs/3rdparty/freeRtos:freertos_headers",
    ],
    target_compatible_with = ["//bazel/platform/constraints/soc:s32k344"],
    visibility = ["//libs/3rdparty/freeRtos:__pkg__"],
)

cc_library(
    name = "main",
    srcs = [
        "src/lifecycle/StaticBsp.cpp",
        "src/main.cpp",
        "src/systems/BspSystem.cpp",
        "src/systems/CanSystem.cpp",
    ],
    hdrs = [
        "include/lifecycle/StaticBsp.h",
        "include/systems/BspSystem.h",
        "include/systems/CanSystem.h",
    ],
    implementation_deps = [
        ":start_up",
        "//executables/referenceApp/platforms/s32k344evb/bspConfiguration:bsp_configuration",
        "//executables/referenceApp/safety/safeSupervisor:safe_supervisor",
        "//platforms/s32k3xx/3rdparty/freertos_cm7_sysTick:freertos_cm7_sys_tick",
        "//platforms/s32k3xx/bsp/bspClock:bsp_clock",
        "//platforms/s32k3xx/bsp/bspMcu:bsp_mcu",
    ],
    strip_include_prefix = "include",
    target_compatible_with = ["//bazel/platform/constraints/soc:s32k344"],
    visibility = ["//visibility:public"],
    deps = [
        "//executables/referenceApp/configuration",
        "//libs/3rdparty/etl",
        "//libs/bsp/bspInputManager:bsp_input_manager",
        "//libs/bsp/bspOutputManager:bsp_output_manager",
        "//libs/bsp/bspOutputPwm:bsp_output_pwm",
        "//libs/bsw/asyncConsole:async_console",
        "//libs/bsw/bsp",
        "//libs/bsw/lifecycle",
        "//platforms/s32k3xx/bsp/bspAdc:bsp_adc",
        "//platforms/s32k3xx/bsp/canflex2Transceiver:canflex2_transceiver",
    ],
)
