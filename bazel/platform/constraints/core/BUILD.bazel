# Processor core constraint. @platforms//cpu captures the architecture
# (armv7e-m covers both Cortex-M4 and Cortex-M7) but not the core, which
# decides the -mcpu/-mfpu flags. This dimension selects the CC toolchain.
constraint_setting(
    name = "core",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "cortex_m4",
    constraint_setting = ":core",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "cortex_m7",
    constraint_setting = ":core",
    visibility = ["//visibility:public"],
)
